# CollectionsOS Cloud Configuration Template
# Copy this to .env for production deployments

POSTGRES_DB=collections
POSTGRES_USER=collections
POSTGRES_PASSWORD=change_this_secure_password_in_prod

# Backend Settings
SECRET_KEY=generate_a_random_32_character_secret_key_here
DATABASE_URL=postgresql+psycopg://collections:change_this_secure_password_in_prod@db:5432/collections
CORS_ORIGINS=["*"]

# Frontend Settings
VITE_API_URL=http://localhost:8000/api
